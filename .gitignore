# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# private working notes — this repo is public.
# Only the design doc is tracked, so agents in git worktrees can read it.
/notes/*
!/notes/DESIGN_DOC.md
!/notes/WORK_PACKAGES.md

# Also match by filename, wherever they live. The docs folder has been renamed
# repeatedly this session ("Portfolio Files/" <-> "notes/"), and each rename
# silently un-ignored everything inside it — once staging the whole private set
# for commit on this public repo. Filename rules survive the renaming.
portfolio-vision.md
portfolio-session-summary.md
portfolio-references.md
site-teardowns.md
PLAYGROUND.md
whspr.md
aira.md
resy-celebrations.md
gesturesketch.md

# ...but never the two docs the build agents must read.
!DESIGN_DOC.md
!WORK_PACKAGES.md
